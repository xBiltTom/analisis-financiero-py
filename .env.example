# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como .env:
#   cp .env.example .env
# Y completa los valores con tus credenciales reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔑 CREDENCIALES DE INTELIGENCIA ARTIFICIAL (Groq API)
# ------------------------------------------------------------------------------
# Obtén tu API Key gratuita registrándote en: https://console.groq.com/keys
# Formato típico: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_tu_api_key_aqui

# ------------------------------------------------------------------------------
# ⚙️ CONFIGURACIÓN DEL MODELO DE IA
# ------------------------------------------------------------------------------
# Modelo LLM a utilizar para el análisis financiero
GROQ_MODEL=openai/gpt-oss-20b

# Parámetros de generación
GROQ_TEMPERATURE=0.6
GROQ_TOP_P=0.9

# Límites de tokens por fase de análisis (3 fases especializadas)
GROQ_MAX_TOKENS_FASE1=2500  # Fase 1: Liquidez y Endeudamiento
GROQ_MAX_TOKENS_FASE2=2800  # Fase 2: Rentabilidad y Eficiencia
GROQ_MAX_TOKENS_FASE3=2500  # Fase 3: Conclusión y Recomendaciones
